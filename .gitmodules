[submodule "binutils"]
	path = binutils
	url = https://github.com/s117/riscv-binutils-gdb.git
	branch = riscv-binutils-2.47-anycore
	shallow = true
[submodule "gcc"]
	path = gcc
	url = https://github.com/gcc-mirror/gcc.git
	branch = releases/gcc-16
	shallow = true
[submodule "glibc"]
	path = glibc
	url = https://github.com/s117/riscv-glibc.git
	branch = riscv-glibc-2.44-anycore
	shallow = true
[submodule "dejagnu"]
	path = dejagnu
	url = https://git.savannah.gnu.org/git/dejagnu.git
	branch = master
	shallow = true
[submodule "newlib"]
	path = newlib
	url = https://github.com/s117/riscv-newlib.git
	branch = riscv-newlib-4.6.0-anycore
	shallow = true
[submodule "musl"]
	path = musl
	url = https://github.com/kraj/musl.git
	branch = master
	shallow = true
[submodule "llvm"]
	path = llvm
	url = https://github.com/s117/llvm-project.git
	branch = anycore-gcc_16.1.0-llvm_22.1.8
	shallow = true
[submodule "uclibc-ng"]
	path = uclibc-ng
	url = https://github.com/wbx-github/uclibc-ng.git
	shallow = true
[submodule "picolibc"]
	path = picolibc
	url = https://github.com/picolibc/picolibc.git
	shallow = true
