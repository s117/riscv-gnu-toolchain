[submodule "binutils"]
	path = binutils
	url = https://github.com/s117/riscv-binutils-gdb.git
	branch = riscv-binutils-2.41-anycore
[submodule "gcc"]
	path = gcc
	url = https://gcc.gnu.org/git/gcc.git
	branch = releases/gcc-13
[submodule "glibc"]
	path = glibc
	url = https://github.com/s117/riscv-glibc.git
	branch = riscv-glibc-2.38-anycore
[submodule "dejagnu"]
	path = dejagnu
	url = https://git.savannah.gnu.org/git/dejagnu.git
	branch = master
[submodule "newlib"]
	path = newlib
	url = https://github.com/s117/riscv-newlib.git
	branch = riscv-newlib-4.3.0-anycore
[submodule "musl"]
	path = musl
	url = https://git.musl-libc.org/git/musl
	branch = master
[submodule "llvm"]
	path = llvm
	url = git@github.ncsu.edu:rsingh25/llvm-project-nx.git
	branch = nx/release/17.0.2
